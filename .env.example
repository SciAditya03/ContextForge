# ---------------------------------------------------------------------------
# ContextForge configuration. Copy to `.env` (never commit the real file).
# Provider keys set here take precedence over keys saved in the Settings UI,
# are only read by the backend, and are never sent to the browser.
# ---------------------------------------------------------------------------

# --- LLM providers (set the ones you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Any OpenAI-compatible server (vLLM, Ollama, LM Studio, gateways)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Default provider for new analyses when nothing is saved in Settings:
# none | anthropic | openai | gemini | openai_compatible
CONTEXTFORGE_DEFAULT_PROVIDER=none
CONTEXTFORGE_DEFAULT_MODEL=

# --- Server ---
CONTEXTFORGE_DATA_DIR=./data
CONTEXTFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CONTEXTFORGE_LOG_LEVEL=INFO
# Fernet key for encrypting API keys stored via the UI (generated into DATA_DIR/.secret.key if empty).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTEXTFORGE_SECRET_KEY=
# Optional shared secret required on /api/* (Authorization: Bearer <token>). Not a user system.
CONTEXTFORGE_API_TOKEN=
# Allow custom base URLs for OpenAI/Anthropic/Gemini (gateways). Off by default: a base URL receives the provider key.
CONTEXTFORGE_ALLOW_PROVIDER_BASE_URL_OVERRIDE=false

# --- Upload / extraction limits ---
CONTEXTFORGE_MAX_UPLOAD_MB=200
CONTEXTFORGE_MAX_EXTRACTED_MB=1024
CONTEXTFORGE_MAX_FILE_COUNT=50000
CONTEXTFORGE_MAX_SINGLE_FILE_MB=50
CONTEXTFORGE_MAX_COMPRESSION_RATIO=200
CONTEXTFORGE_EXTRACTION_TIMEOUT_S=120

# --- Analysis defaults ---
CONTEXTFORGE_MAX_PARSE_FILE_KB=1024
CONTEXTFORGE_MAX_CONCURRENT_AI_REQUESTS=4
CONTEXTFORGE_DEFAULT_TOKEN_BUDGET=400000
CONTEXTFORGE_KEEP_EXTRACTED_SOURCES=false

# --- Frontend (runtime) ---
# URL the browser uses to reach the API
CONTEXTFORGE_PUBLIC_API_URL=http://localhost:8000
# Only if CONTEXTFORGE_API_TOKEN is set: exposed to the browser, so use it only for private deployments
CONTEXTFORGE_PUBLIC_API_TOKEN=
